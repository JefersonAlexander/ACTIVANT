APP_ENV=development
# Opcionales para ejecutar la portada. Obligatorias al utilizar un cliente Supabase.
# Copiar a .env.local y completar con los valores del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usar exclusivamente la clave publicable. Nunca colocar service_role, claves
# secretas, contraseñas de base de datos ni tokens de acceso en NEXT_PUBLIC_*.

# Origen canónico del aplicativo para correos/callbacks. Solo servidor.
# En producción debe ser HTTPS y coincidir con Supabase Auth > URL Configuration.
APP_URL=http://localhost:3000

# Opcional: solo servidor, para invitaciones administrativas mediante Supabase Auth.
# Usar una clave secreta sb_secret_ del mismo proyecto; nunca NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
